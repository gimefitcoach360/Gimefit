{
  "rewrites": [
    {
      "source": "/recetario",
      "destination": "/recetario/index.html"
    },
    {
      "source": "/recetario-dulce",
      "destination": "/recetario-dulce/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
